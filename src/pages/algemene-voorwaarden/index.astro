---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/shared.css";
import "../../styles/legal.css";

const versionFiles = import.meta.glob("../../content/legal/voorwaarden/*.md", { eager: true }) as Record<string, any>;
const versions = Object.entries(versionFiles)
  .map(([path, mod]) => ({
    slug: (path.split('/').pop() as string).replace('.md', ''),
    frontmatter: mod.frontmatter,
    Content: mod.default,
  }))
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const current = versions[0];
const { title, version, date } = current.frontmatter;
const Content = current.Content;
const formattedDate = new Date(date).toLocaleDateString("nl-BE", { day: "numeric", month: "long", year: "numeric" });
---

<Base
  title="algemene voorwaarden"
  description="De algemene voorwaarden van WeIT - versie, datum en de volledige tekst die van toepassing is op offertes en overeenkomsten."
  translated={false}
  noindex={current.frontmatter.status !== "actief"}
>
  <Nav slot="nav" translated={false} />

  <section class="page-hero">
    <div class="page-hero-content">
      <div class="label mono">// algemene voorwaarden</div>
      <h1>{title}</h1>
      <p>Versie {version} - {formattedDate}. Iedere offerte verwijst naar de op dat moment toepasselijke, gedateerde versie op een vaste URL.</p>
    </div>
  </section>

  <article class="legal-content">
    <div class="legal-meta">
      <span class="pill">versie {version}</span>
      <span class="pill">{formattedDate}</span>
    </div>
    <Content />
  </article>

  {versions.length > 0 && (
    <section class="version-history">
      <h2 class="mono">// versiegeschiedenis</h2>
      <table>
        <thead>
          <tr><th>Versie</th><th>Datum</th><th>Status</th><th>Vaste URL</th></tr>
        </thead>
        <tbody>
          {versions.map((v, i) => (
            <tr class={i === 0 ? "is-current" : ""}>
              <td>{v.frontmatter.version}{i === 0 && <span class="current-tag">huidig</span>}</td>
              <td>{new Date(v.frontmatter.date).toLocaleDateString("nl-BE", { day: "numeric", month: "long", year: "numeric" })}</td>
              <td>{v.frontmatter.status}</td>
              <td><a href={`/algemene-voorwaarden/${v.slug}`}>/algemene-voorwaarden/{v.slug}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <Footer slot="footer" />
</Base>

---
export const prerender = false;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wachtwoord instellen — weit.be</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: Inter, sans-serif; background: #f0f0ef; min-height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; padding: 24px; }
    .card { background: #fff; border: 1px solid #e5e5e5; border-radius: 10px; padding: 36px 32px; width: 100%; max-width: 380px; }
    .logo { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #2dd4bf; margin-bottom: 28px; }
    h1 { font-size: 18px; font-weight: 600; margin: 0 0 6px; }
    p { font-size: 13px; color: #888; margin: 0 0 24px; }
    label { display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px; }
    input[type=password] { width: 100%; padding: 9px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; font-family: inherit; outline: none; margin-bottom: 12px; }
    input[type=password]:focus { border-color: #2dd4bf; }
    button { width: 100%; padding: 10px; background: #2dd4bf; color: #fff; border: none; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer; margin-top: 4px; }
    button:hover { opacity: 0.88; }
    button:disabled { opacity: 0.5; cursor: default; }
    .msg { font-size: 13px; margin-top: 12px; padding: 10px; border-radius: 6px; }
    .msg.ok  { background: #eafaf1; color: #1e8449; }
    .msg.err { background: #fdf0ed; color: #c0392b; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">// weit.be</div>
    <h1>Wachtwoord instellen</h1>
    <p>Kies een wachtwoord voor je account.</p>

    <form id="form">
      <label for="pw">Nieuw wachtwoord</label>
      <input type="password" id="pw" placeholder="Minimaal 8 tekens" required minlength="8" />
      <label for="pw2">Bevestig wachtwoord</label>
      <input type="password" id="pw2" placeholder="Herhaal wachtwoord" required minlength="8" />
      <button type="submit" id="btn">Instellen</button>
    </form>

    <div id="msg" style="display:none;" class="msg"></div>
  </div>

  <script id="cfg" type="application/json" set:text={JSON.stringify({ supabaseUrl, supabaseKey })}></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <script>
    (async function () {
      const cfg = JSON.parse(document.getElementById('cfg').textContent);
      const sb  = supabase.createClient(cfg.supabaseUrl, cfg.supabaseKey);

      // Controleer of we een actieve sessie hebben
      const { data: { session } } = await sb.auth.getSession();
      if (!session) {
        window.location.href = '/portal/login';
        return;
      }

      const form = document.getElementById('form');
      const btn  = document.getElementById('btn');
      const msg  = document.getElementById('msg');

      function showMsg(text, type) {
        msg.textContent  = text;
        msg.className    = 'msg ' + type;
        msg.style.display = 'block';
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const pw  = document.getElementById('pw').value;
        const pw2 = document.getElementById('pw2').value;

        if (pw !== pw2) { showMsg('Wachtwoorden komen niet overeen.', 'err'); return; }

        btn.disabled    = true;
        btn.textContent = 'Even wachten...';

        const { error } = await sb.auth.updateUser({ password: pw });

        if (error) {
          showMsg(error.message, 'err');
          btn.disabled    = false;
          btn.textContent = 'Instellen';
        } else {
          showMsg('Wachtwoord ingesteld! Je wordt doorgestuurd...', 'ok');
          setTimeout(() => { window.location.href = '/portal'; }, 1500);
        }
      });
    })();
  </script>
</body>
</html>

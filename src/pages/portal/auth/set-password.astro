---
export const prerender = false;
import { createSupabaseServerClient } from '../../../lib/supabase';

const responseHeaders = new Headers();
const supabase = createSupabaseServerClient(Astro.request, responseHeaders);
const { data: { user } } = await supabase.auth.getUser();

if (!user) return Astro.redirect('/portal/login');

let error = '';

if (Astro.request.method === 'POST') {
  const form     = await Astro.request.formData();
  const password = form.get('password')?.toString() ?? '';
  const confirm  = form.get('confirm')?.toString() ?? '';

  if (password !== confirm) {
    error = 'Wachtwoorden komen niet overeen.';
  } else if (password.length < 8) {
    error = 'Wachtwoord moet minimaal 8 tekens bevatten.';
  } else {
    const { error: e } = await supabase.auth.updateUser({ password });
    if (e) {
      error = e.message;
    } else {
      return new Response(null, {
        status: 302,
        headers: { ...Object.fromEntries(responseHeaders), Location: '/portal' },
      });
    }
  }
}
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wachtwoord instellen — weit.be</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: Inter, sans-serif; background: #f0f0ef; min-height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; padding: 24px; }
    .card { background: #fff; border: 1px solid #e5e5e5; border-radius: 10px; padding: 36px 32px; width: 100%; max-width: 380px; }
    .logo { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #2dd4bf; margin-bottom: 28px; }
    h1 { font-size: 18px; font-weight: 600; margin: 0 0 6px; }
    p { font-size: 13px; color: #888; margin: 0 0 24px; }
    label { display: block; font-size: 12px; font-weight: 500; margin-bottom: 4px; color: #333; }
    input[type=password] { width: 100%; padding: 9px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; font-family: inherit; outline: none; margin-bottom: 14px; }
    input[type=password]:focus { border-color: #2dd4bf; }
    button { width: 100%; padding: 10px; background: #2dd4bf; color: #fff; border: none; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer; }
    button:hover { opacity: 0.88; }
    .err { background: #fdf0ed; color: #c0392b; border-radius: 6px; padding: 10px 12px; font-size: 13px; margin-bottom: 16px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">// weit.be</div>
    <h1>Wachtwoord instellen</h1>
    <p>Kies een wachtwoord voor <strong>{user.email}</strong>.</p>

    {error && <div class="err">{error}</div>}

    <form method="POST">
      <label for="pw">Nieuw wachtwoord</label>
      <input type="password" id="pw" name="password" required minlength="8" placeholder="Minimaal 8 tekens" autofocus />
      <label for="pw2">Bevestig wachtwoord</label>
      <input type="password" id="pw2" name="confirm" required minlength="8" placeholder="Herhaal wachtwoord" />
      <button type="submit">Instellen & aanmelden</button>
    </form>
  </div>
</body>
</html>

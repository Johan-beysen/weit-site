---
export const prerender = false;
import { createSupabaseServerClient } from '../../../lib/supabase';

// PKCE flow: ?code= in URL — server-side afhandeling
const url  = new URL(Astro.request.url);
const code = url.searchParams.get('code');
const type = url.searchParams.get('type');
const responseHeaders = new Headers();

if (code) {
  const supabase = createSupabaseServerClient(Astro.request, responseHeaders);
  await supabase.auth.exchangeCodeForSession(code);
  const dest = (type === 'recovery' || type === 'invite') ? '/portal/auth/set-password' : '/portal';
  return new Response(null, {
    status: 302,
    headers: { ...Object.fromEntries(responseHeaders), Location: dest },
  });
}

// Geen code = implicit flow (hash tokens) — client doet fetch naar /portal/auth/set-session
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aanmelden...</title>
  <style>
    body { font-family: Inter, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background: #f5f5f5; color: #555; font-size: 14px; }
  </style>
</head>
<body>
  <p id="msg">Even geduld, je wordt aangemeld...</p>
  <script>
    (async function () {
      const params = new URLSearchParams(window.location.hash.substring(1));
      const access_token  = params.get('access_token');
      const refresh_token = params.get('refresh_token');
      const type          = params.get('type');
      const error         = params.get('error');
      const msg           = document.getElementById('msg');

      if (error) {
        msg.textContent = 'Link ongeldig of verlopen. Vraag een nieuwe aan.';
        return;
      }

      if (!access_token || !refresh_token) {
        window.location.href = '/portal/login';
        return;
      }

      const res  = await fetch('/portal/auth/set-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ access_token, refresh_token, type }),
      });
      const data = await res.json();

      if (data.ok) {
        window.location.href = data.redirect;
      } else {
        msg.textContent = 'Aanmelden mislukt: ' + (data.error ?? 'onbekende fout');
      }
    })();
  </script>
</body>
</html>

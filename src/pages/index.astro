---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HeroCode from "../components/HeroCode.astro";
import "../styles/shared.css";
import "../styles/home.css";

const projectFiles = import.meta.glob("../content/projects/*.md", { eager: true });
const featuredProjects = (Object.values(projectFiles) as any[]).slice(0, 3);
---

<Base title="home" description="Wij helpen organisaties hun digitale omgeving begrijpen, beveiligen en efficiënter laten draaien - van kwetsbaarheden opsporen tot infrastructure die overeind blijft.">
  <Nav slot="nav" />

  <section class="hero">
    <div class="hero-content">
      <div class="label mono">// security · infrastructure · development · automation</div>
      <h1>Digitale problemen<br />oplossen, van begin<br />tot einde.</h1>
      <p>Wij helpen organisaties hun digitale omgeving begrijpen, beveiligen en efficiënter laten draaien - van kwetsbaarheden opsporen tot infrastructure die overeind blijft.</p>
      <div class="hero-cta">
        <a href="/contact" class="btn-primary">Neem contact op</a>
      </div>
    </div>
    <HeroCode />
  </section>

  <section class="diensten">
    <div class="section-label mono">// wat wij doen</div>
    <p class="diensten-intro">Van offensieve security tot automatisatie en AI-integratie - hieronder een overzicht.</p>
    <div class="diensten-grid">

      <a href="/security" class="dienst-card featured">
        <h3>[Security]</h3>
        <p>Kwetsbaarheden opsporen vóór anderen ze misbruiken. Pentesting, security audits en NIS2/Cyfun-begeleiding.</p>
        <span class="mono arrow">→ meer</span>
      </a>

      <a href="/infrastructure" class="dienst-card">
        <h3>[Infrastructure]</h3>
        <p>Servers, netwerken, cloud en Microsoft 365 - stevig ingericht en overzichtelijk beheerd.</p>
        <span class="mono arrow">→ meer</span>
      </a>

      <a href="/development" class="dienst-card">
        <h3>[Development]</h3>
        <p>Webapplicaties, tools en integraties. Clean code, geen overbodige complexiteit.</p>
        <span class="mono arrow">→ meer</span>
      </a>

      <a href="/automation" class="dienst-card">
        <h3>[Automation]</h3>
        <p>Repetitief werk uit handen nemen. Workflows, scripts en slimme koppelingen.</p>
        <span class="mono arrow">→ meer</span>
      </a>

      <a href="/ai-integratie" class="dienst-card">
        <h3>[AI-integratie]</h3>
        <p>Workflows die zelfstandig taken uitvoeren - van agentic automatisering tot AI-ondersteunde security tooling.</p>
        <span class="mono arrow">→ meer</span>
      </a>

      <a href="/consulting" class="dienst-card">
        <h3>[Consulting]</h3>
        <p>Meedenken over digitale vraagstukken. Van procesanalyse tot technische roadmap.</p>
        <span class="mono arrow">→ meer</span>
      </a>

    </div>
  </section>

  <section class="projecten">
    <div class="section-header">
      <div class="section-label mono">// projecten</div>
      <a href="/projects" class="mono subtle">alle projecten →</a>
    </div>
    <div class="projecten-grid">
      {featuredProjects.map((project: any) => {
        const slug = project.file.split('/').pop().replace('.md', '');
        return (
          <a href={`/projects/${slug}`} class="project-card">
            <span class="tag mono">{project.frontmatter.category}</span>
            <h4>{project.frontmatter.title}</h4>
            <p>{project.frontmatter.summary}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="contact-cta">
    <div class="section-label mono">// contact</div>
    <h2>Een project in gedachten?</h2>
    <p>Vertel ons wat je nodig hebt - geen verplichtingen, gewoon een gesprek.</p>
    <a href="/contact" class="btn-primary">Stuur een bericht</a>
  </section>

  <Footer slot="footer" />
</Base>

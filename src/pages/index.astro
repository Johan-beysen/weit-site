---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/shared.css";
import "../styles/home.css";
---

<Base title="home">
  <Nav slot="nav" />

  <section class="hero">
    <div class="hero-content">
      <div class="label mono">// consulting · development · automation</div>
      <h1>Digitale problemen<br />oplossen, van begin<br />tot einde.</h1>
      <p>Ik help bedrijven bouwen wat werkt, automatiseren wat tijd kost, en denken over wat complex lijkt.</p>
      <div class="hero-cta">
        <a href="/contact" class="btn-primary">Neem contact op</a>
        <a href="/projects" class="mono subtle">↓ bekijk projecten</a>
      </div>
    </div>
    <div class="hero-code mono" aria-hidden="true">
      <span class="kw">const</span> <span class="fn">weit</span> = &#123;<br />
      &nbsp;&nbsp;focus: <span class="str">"resultaat"</span>,<br />
      &nbsp;&nbsp;aanpak: <span class="str">"pragmatisch"</span>,<br />
      &nbsp;&nbsp;overhead: <span class="val">false</span><br />
      &#125;
    </div>
  </section>

  <section class="diensten">
    <div class="section-label mono">// wat ik doe</div>
    <div class="diensten-grid">

      <a href="/consulting" class="dienst-card">
        <div class="icon">&#x1F4A1;</div>
        <h3>consulting</h3>
        <p>Meedenken over digitale vraagstukken. Van procesanalyse tot technische roadmap.</p>
        <span class="mono arrow">→ meer</span>
      </a>

      <a href="/development" class="dienst-card featured">
        <div class="icon">&#x1F4BB;</div>
        <h3>development</h3>
        <p>Webapplicaties, tools en integraties. Clean code, geen overbodige complexiteit.</p>
        <span class="mono arrow">→ meer</span>
      </a>

      <a href="/automation" class="dienst-card">
        <div class="icon">&#x2699;&#xFE0F;</div>
        <h3>automation</h3>
        <p>Repetitief werk uit handen nemen. Workflows, scripts en slimme koppelingen.</p>
        <span class="mono arrow">→ meer</span>
      </a>

    </div>
  </section>

  <section class="projecten">
    <div class="section-header">
      <div class="section-label mono">// projecten</div>
      <a href="/projects" class="mono subtle">alle projecten →</a>
    </div>
    <div class="projecten-grid">
      <div class="project-card empty">
        <span class="tag mono">binnenkort</span>
        <h4>Projecten volgen</h4>
        <p>Portfolio groeit project per project. Wordt vervolgd.</p>
      </div>
    </div>
  </section>

  <section class="contact-cta">
    <div class="section-label mono">// contact</div>
    <h2>Een project in gedachten?</h2>
    <p>Vertel me wat je nodig hebt — geen verplichtingen, gewoon een gesprek.</p>
    <a href="/contact" class="btn-primary">Stuur een bericht</a>
  </section>

  <Footer slot="footer" />
</Base>

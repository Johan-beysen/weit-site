---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import HeroCode from "../../components/HeroCode.astro";
import "../../styles/shared.css";
import "../../styles/contact.css";
---

<Base title="contact" description="Bring me your digital question - you'll get an honest first answer within one business day. Send a message or schedule a conversation right away, no obligations.">
  <Nav slot="nav" />

  <section class="page-hero">
    <div class="page-hero-content">
      <div class="label mono">// contact</div>
      <h1>Bring me your question.</h1>
      <p>You'll get an honest first answer within one business day. Send me a message or schedule a conversation right away - no obligations.</p>
    </div>
    <HeroCode />
  </section>

  <section class="contact-grid">

    <div class="form-block">
      <div class="mono section-label">// send a message</div>
      <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="9911e82b-b3eb-431c-918c-e3e0ae4aea36" />
        <input type="hidden" name="subject" value="New message via WeIT.be" />
        <input type="hidden" name="redirect" value="false" />
        <input type="checkbox" name="botcheck" class="honeypot" />

        <div class="field">
          <label for="name">name</label>
          <input type="text" id="name" name="name" required placeholder="Jane Doe" />
        </div>

        <div class="field">
          <label for="email">email</label>
          <input type="email" id="email" name="email" required placeholder="jane@company.com" />
        </div>

        <div class="field">
          <label for="company">company <span class="optional">(optional)</span></label>
          <input type="text" id="company" name="company" placeholder="Company Ltd" />
        </div>

        <div class="field">
          <label for="message">message</label>
          <textarea id="message" name="message" required rows="5" placeholder="Tell me what you need..."></textarea>
        </div>

        <button type="submit" id="submit-btn">Send message</button>
        <div id="form-result" class="form-result"></div>
      </form>
    </div>

    <div class="expect-block">
      <div class="mono section-label">// what to expect</div>
      <ul class="expect-list">
        <li>
          <span class="expect-title">[Fast response]</span>
          <p>You'll hear from me within 1 business day - no weeks of silence.</p>
        </li>
        <li>
          <span class="expect-title">[No-obligation introduction]</span>
          <p>A conversation with no strings attached. You talk, I listen and think along.</p>
        </li>
        <li>
          <span class="expect-title">[Open communication]</span>
          <p>I say what I think, including about what's not feasible. No empty promises.</p>
        </li>
      </ul>
    </div>

  </section>

  <Footer slot="footer" />
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const result = document.getElementById("form-result");
  const btn = document.getElementById("submit-btn");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn!.textContent = "Sending...";
    btn!.setAttribute("disabled", "true");

    const formData = new FormData(form);
    const response = await fetch("https://api.web3forms.com/submit", {
      method: "POST",
      body: formData,
    });
    const data = await response.json();

    if (data.success) {
      result!.textContent = "Message sent - I'll get back to you as soon as possible.";
      result!.className = "form-result success";
      form.reset();
    } else {
      result!.textContent = `Error: ${data.message ?? "Unknown error"}`;
      result!.className = "form-result error";
    }

    btn!.textContent = "Send message";
    btn!.removeAttribute("disabled");
  });
</script>

---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HeroCode from "../components/HeroCode.astro";
import "../styles/shared.css";
import "../styles/services.css";
import "../styles/rich-service.css";
---

<Base title="infrastructuur">
  <Nav slot="nav" />

  <section class="page-hero">
    <div class="page-hero-content">
      <div class="label mono">// infrastructuur</div>
      <h1>Een stevig fundament<br />onder elk beleid.</h1>
      <p>Een stevig beveiligingsbeleid staat of valt met de infrastructuur eronder. Wij bouwen en beheren de systemen die overeind moeten blijven.</p>
    </div>
    <HeroCode />
  </section>

  <section class="diensten-detail">
    <div class="sectie-blok">
      <div class="mono section-label">// server- en netwerkbeheer</div>
      <div class="items">
        <div class="item">
          <h3>Server- en Netwerkbeheer</h3>
          <p>Opzet en beheer van Windows Server-omgevingen, Active Directory, Hyper-V-virtualisatie, DHCP/DNS en VLAN-segmentatie.</p>
        </div>
        <div class="item">
          <h3>Cloud &amp; Virtualisatie</h3>
          <p>Inrichting van Azure- en Entra ID-omgevingen, on-premise virtualisatie (TrueNAS, ESXi) en containerization met Docker.</p>
        </div>
        <div class="item">
          <h3>Monitoring &amp; Logging Setup</h3>
          <p>Inrichting van monitoring- en logging-oplossingen (o.a. Zabbix/SNMP) zodat afwijkingen vroeg zichtbaar worden — niet pas na een incident.</p>
        </div>
      </div>
    </div>

    <div class="sectie-blok alt">
      <div class="mono section-label">// microsoft 365 diensten</div>
      <div class="items">
        <div class="item">
          <h3>M365 Migraties</h3>
          <p>Begeleiding van on-premise naar cloud, tenant-to-tenant migraties, en overzetten van mailboxen, SharePoint en OneDrive zonder dataverlies of downtime.</p>
        </div>
        <div class="item">
          <h3>Backup &amp; Disaster Recovery</h3>
          <p>Opzet van betrouwbare back-upoplossingen voor Exchange, SharePoint, Teams en OneDrive, inclusief retentiebeleid en periodieke restore-testing.</p>
        </div>
        <div class="item">
          <h3>Entra ID / Intune Beheer</h3>
          <p>Identity governance, device management en conditional access, afgestemd op de grootte en het risicoprofiel van je organisatie.</p>
        </div>
      </div>
    </div>

    <div class="sectie-blok">
      <div class="mono section-label">// databankbeheer</div>
      <div class="items">
        <div class="item">
          <h3>SQL Server Administratie</h3>
          <p>Installatie, configuratie, back-up/restore-strategieën en performance tuning van SQL Server-omgevingen.</p>
        </div>
        <div class="item">
          <h3>Data Migratie &amp; Import/Export</h3>
          <p>Veilig en gecontroleerd verplaatsen van data tussen systemen, met aandacht voor integriteit en minimale downtime.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-cta">
    <div class="mono section-label">// samen bekijken?</div>
    <h2>Infrastructuur die meegroeit?</h2>
    <p>Of het nu gaat om een volledige migratie of een kleine optimalisatie — wij denken mee vanaf de eerste vraag.</p>
    <a href="/contact" class="btn-primary">Infrastructuur bespreken</a>
  </section>

  <Footer slot="footer" />
</Base>

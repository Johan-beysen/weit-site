---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/shared.css";
import "../styles/contact.css";
---

<Base title="contact">
  <Nav slot="nav" />

  <section class="page-hero">
    <div class="label mono">// contact</div>
    <h1>Een project in gedachten?</h1>
    <p>Heb je een project in gedachten, wil je eens zonder verplichtingen brainstormen over een idee, stuur me een berichtje of plan een meeting in, no strings attached.</p>
  </section>

  <section class="contact-grid">

    <div class="form-block">
      <div class="mono section-label">// stuur een bericht</div>
      <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="9911e82b-b3eb-431c-918c-e3e0ae4aea36" />
        <input type="hidden" name="subject" value="Nieuw bericht via weit.be" />
        <input type="hidden" name="redirect" value="false" />
        <input type="checkbox" name="botcheck" class="honeypot" />

        <div class="field">
          <label for="name">naam</label>
          <input type="text" id="name" name="name" required placeholder="Jan Janssen" />
        </div>

        <div class="field">
          <label for="email">e-mail</label>
          <input type="email" id="email" name="email" required placeholder="jan@bedrijf.be" />
        </div>

        <div class="field">
          <label for="company">bedrijf <span class="optional">(optioneel)</span></label>
          <input type="text" id="company" name="company" placeholder="Bedrijf BV" />
        </div>

        <div class="field">
          <label for="message">bericht</label>
          <textarea id="message" name="message" required rows="5" placeholder="Vertel me wat je nodig hebt..."></textarea>
        </div>

        <button type="submit" id="submit-btn">Verstuur bericht</button>
        <div id="form-result" class="form-result"></div>
      </form>
    </div>

    <div class="cal-block">
      <div class="mono section-label">// plan een gesprek</div>
      <div class="cal-wrapper">
        <div class="cal-inner" id="my-cal-inline-project-intake"></div>
      </div>
    </div>

  </section>

  <Footer slot="footer" />
</Base>

<script type="text/javascript">
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal; let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {}; cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.eu/embed/embed.js", "init");

  Cal("init", "project-intake", { origin: "https://app.cal.eu" });
  Cal.ns["project-intake"]("inline", {
    elementOrSelector: "#my-cal-inline-project-intake",
    config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
    calLink: "johan-beysen-3rh9fy/project-intake",
  });
  Cal.ns["project-intake"]("ui", {
    hideEventTypeDetails: false,
    layout: "month_view",
  });
</script>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const result = document.getElementById("form-result");
  const btn = document.getElementById("submit-btn");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn!.textContent = "Bezig...";
    btn!.setAttribute("disabled", "true");

    const formData = new FormData(form);
    const response = await fetch("https://api.web3forms.com/submit", {
      method: "POST",
      body: formData,
    });
    const data = await response.json();

    if (data.success) {
      result!.textContent = "Bericht verzonden — ik neem zo snel mogelijk contact op.";
      result!.className = "form-result success";
      form.reset();
    } else {
      result!.textContent = `Fout: ${data.message ?? "Onbekende fout"}`;
      result!.className = "form-result error";
    }

    btn!.textContent = "Verstuur bericht";
    btn!.removeAttribute("disabled");
  });
</script>

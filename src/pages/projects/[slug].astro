---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/shared.css";
import "../../styles/project-detail.css";

export async function getStaticPaths() {
  const projectFiles = import.meta.glob("../../content/projects/*.md", { eager: true });
  return Object.entries(projectFiles).map(([path, project]) => ({
    params: {
      slug: (path.split('/').pop() as string).replace('.md', '')
    },
    props: { project: project as any }
  }));
}

const { project } = Astro.props;
const { title, category, year, summary, client, stack } = project.frontmatter;
const Content = project.default ?? (() => null);
---

<Base title={title}>
  <Nav slot="nav" />

  <section class="page-hero">
    <div class="meta">
      <span class="tag mono">{category}</span>
      {year && <span class="year mono">{year}</span>}
    </div>
    <h1>{title}</h1>
    <p>{summary}</p>
    {(client || stack) && (
      <div class="details">
        {client && (
          <div class="detail">
            <span class="mono label">// client</span>
            <span>{client}</span>
          </div>
        )}
        {stack && (
          <div class="detail">
            <span class="mono label">// stack</span>
            <span>{stack.join(' · ')}</span>
          </div>
        )}
      </div>
    )}
  </section>

  <article class="project-content">
    <Content />
  </article>

  <div class="back">
    <a href="/projects" class="mono">← alle projecten</a>
  </div>

  <Footer slot="footer" />
</Base>

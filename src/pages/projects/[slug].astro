---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const projectFiles = import.meta.glob("../../content/projects/*.md", { eager: true });
  return Object.entries(projectFiles).map(([path, project]) => ({
    params: {
      slug: path.split('/').pop().replace('.md', '')
    },
    props: { project }
  }));
}

const { project } = Astro.props;
const { title, category, year, summary, client, stack } = project.frontmatter;
const Content = project.default ?? (() => null);
---

<Base title={title}>
  <Nav slot="nav" />

  <section class="page-hero">
    <div class="meta">
      <span class="tag mono">{category}</span>
      {year && <span class="year mono">{year}</span>}
    </div>
    <h1>{title}</h1>
    <p>{summary}</p>
    {(client || stack) && (
      <div class="details">
        {client && (
          <div class="detail">
            <span class="mono label">// client</span>
            <span>{client}</span>
          </div>
        )}
        {stack && (
          <div class="detail">
            <span class="mono label">// stack</span>
            <span>{stack.join(' · ')}</span>
          </div>
        )}
      </div>
    )}
  </section>

  <article class="project-content">
    <Content />
  </article>

  <div class="back">
    <a href="/projects" class="mono">← alle projecten</a>
  </div>

  <Footer slot="footer" />
</Base>

<style>
  .mono { font-family: var(--mono); }

  .page-hero {
    padding: 64px 48px 56px;
    border-bottom: 1px solid var(--border);
    max-width: 720px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .tag {
    font-size: 11px;
    background: #E1F5EE;
    color: #085041;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .year {
    font-size: 11px;
    color: var(--text-muted);
  }
  .page-hero h1 {
    font-size: 36px;
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 20px;
  }
  .page-hero p {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 32px;
  }
  .details {
    display: flex;
    gap: 32px;
  }
  .detail {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .label {
    font-size: 11px;
    color: var(--teal);
    letter-spacing: 0.08em;
  }
  .detail span:last-child {
    font-size: 13px;
    color: var(--text-muted);
  }

  .project-content {
    padding: 56px 48px;
    max-width: 720px;
    border-bottom: 1px solid var(--border);
  }
  .project-content :global(h2) {
    font-size: 20px;
    font-weight: 500;
    margin: 40px 0 16px;
  }
  .project-content :global(h3) {
    font-size: 16px;
    font-weight: 500;
    margin: 28px 0 12px;
  }
  .project-content :global(p) {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 16px;
  }
  .project-content :global(ul) {
    margin: 0 0 16px 20px;
  }
  .project-content :global(li) {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 6px;
  }
  .project-content :global(code) {
    font-family: var(--mono);
    font-size: 13px;
    background: var(--gray-100);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .back {
    padding: 32px 48px;
  }
  .back a {
    font-size: 13px;
    color: var(--text-muted);
  }
  .back a:hover { color: var(--teal); }
</style>
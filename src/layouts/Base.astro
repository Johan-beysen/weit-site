---
const { title = "weit.be" } = Astro.props;
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — weit.be</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --teal: #1D9E75;
      --teal-light: #E1F5EE;
      --teal-dark: #0F6E56;
      --dark: #111111;
      --gray-900: #1a1a1a;
      --gray-600: #888780;
      --gray-200: #D3D1C7;
      --gray-100: #F1EFE8;
      --text: #1a1a1a;
      --text-muted: #5F5E5A;
      --border: rgba(0,0,0,0.1);
      --mono: 'JetBrains Mono', monospace;
      --sans: 'Inter', sans-serif;
    }
    html { font-family: var(--sans); color: var(--text); background: #fff; }
    body { min-height: 100vh; }
    a { color: inherit; text-decoration: none; }
  </style>
</head>
<body>
  <slot name="nav" />
  <main>
    <slot />
  </main>
  <slot name="footer" />
</body>
</html>
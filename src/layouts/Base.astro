---
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import { getLocalizedPathname } from '../i18n';

const {
  title = "WeIT.be",
  titleOverride,
  description = "Cybersecurity, infrastructuur, maatwerk en automatisering - pragmatisch en zonder fluff.",
  image = "/og-image.png",
  // Nederlandstalig-only pagina's (zie i.c. de juridische teksten, artikel 24.4:
  // vertaling volgt pas na definitieve NL-goedkeuring) hebben geen /en/-tegenhanger.
  translated = true,
  // Concept-content (zie PUBLICATIECHECKLIST.md) mag nog niet geïndexeerd worden.
  noindex = false,
} = Astro.props;

const siteName = "WeIT.be";
const pageTitle = titleOverride ?? (title === "home" ? siteName : `${title} - ${siteName}`);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const locale = Astro.currentLocale === 'en' ? 'en' : 'nl';
const nlAlternateURL = new URL(getLocalizedPathname(Astro.url.pathname, 'nl'), Astro.site);
const enAlternateURL = new URL(getLocalizedPathname(Astro.url.pathname, 'en'), Astro.site);
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="nl" href={nlAlternateURL} />
  {translated && <link rel="alternate" hreflang="en" href={enAlternateURL} />}
  <link rel="alternate" hreflang="x-default" href={nlAlternateURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'nl_BE'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />
</head>
<body>
  <slot name="nav" />
  <main>
    <slot />
  </main>
  <slot name="footer" />
</body>
</html>

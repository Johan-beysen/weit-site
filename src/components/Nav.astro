---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, getLocalizedPathname, type Locale } from "../i18n";

// NL-only pagina's (bv. de juridische teksten) hebben geen /en/-tegenhanger -
// zie Base.astro's zelfde prop. De taalschakelaar zou anders naar een
// niet-bestaande pagina linken.
const { translated = true } = Astro.props;

const lang = (Astro.currentLocale === "en" ? "en" : "nl") as Locale;
const t = useTranslations(lang);
const href = (path: string) => getRelativeLocaleUrl(lang, path);

const dienstenLinks = [
  { href: href("/security"), title: t("nav.security.title"), desc: t("nav.security.desc") },
  { href: href("/infrastructure"), title: t("nav.infrastructure.title"), desc: t("nav.infrastructure.desc") },
  { href: href("/development"), title: t("nav.development.title"), desc: t("nav.development.desc") },
  { href: href("/automation"), title: t("nav.automation.title"), desc: t("nav.automation.desc") },
  { href: href(lang === "en" ? "/ai-integration" : "/ai-integratie"), title: t("nav.ai.title"), desc: t("nav.ai.desc") },
  { href: href("/consulting"), title: t("nav.consulting.title"), desc: t("nav.consulting.desc") },
];

const navLinks = [
  { href: href("/projects"), label: t("nav.projects") },
  { href: href("/blog"), label: t("nav.blog") },
  { href: href(lang === "en" ? "/approach" : "/aanpak"), label: t("nav.aanpak") },
  { href: href("/contact"), label: t("nav.contact") },
];

const current = Astro.url.pathname;
const dienstenActive = dienstenLinks.some(link => current.startsWith(link.href));
const otherLocale: Locale = lang === "nl" ? "en" : "nl";
const otherLocaleHref = getLocalizedPathname(current, otherLocale);
---

<nav>
  <a href={href("/")} class="logo">WeIT<span>.</span>be</a>
  <ul>
    <li>
      <details class="dropdown">
        <summary class={dienstenActive ? "active" : ""}>
          {t("nav.diensten")} <span class="mono arrow-down">▾</span>
        </summary>
        <div class="mega-menu">
          <div class="mega-panel">
            {dienstenLinks.map(item => (
              <a href={item.href} class="mega-item">
                <span class="mega-title mono">{item.title}</span>
                <span class="mega-desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </details>
    </li>
    {navLinks.map(link => (
      <li>
        <a href={link.href} class={current.startsWith(link.href) ? "active" : ""}>
          {link.label}
        </a>
      </li>
    ))}
    {translated && (
      <li>
        <a href={otherLocaleHref} class="lang-switch mono">{otherLocale.toUpperCase()}</a>
      </li>
    )}
  </ul>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px var(--gutter);
    border-bottom: 1px solid var(--border);
    background: #fff;
    position: relative;
  }
  .logo {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }
  .logo span { color: var(--teal); }

  ul {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
  }

  a { font-size: 15px; color: var(--text-muted); transition: color 0.15s; }
  a:hover, a.active { color: var(--text); }

  .lang-switch {
    font-size: 12px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 8px;
  }
  .lang-switch:hover { color: var(--teal); border-color: var(--teal); }

  /* --- Diensten-dropdown --------------------------------------- */

  .dropdown { position: relative; }

  summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 15px;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover, summary.active { color: var(--text); }

  /* Pijltje in dezelfde teal/mono-taal als de "// labels" en
     "[haakjes]" elders op de site */
  .arrow-down {
    font-size: 10px;
    color: var(--teal);
    transition: transform 0.15s;
  }
  .dropdown[open] .arrow-down { transform: rotate(180deg); }

  /* Onzichtbare brug zonder gap, zodat hover niet wegvalt tussen
     trigger en menu */
  .mega-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: 14px;
    z-index: 20;
  }
  .dropdown:hover .mega-menu,
  .dropdown[open] .mega-menu {
    display: block;
  }

  .mega-panel {
    width: 480px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 24px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
  }

  .mega-item {
    display: block;
    padding: 8px;
    margin: -8px;
    border-radius: 8px;
    transition: background 0.15s;
  }
  .mega-item:hover { background: var(--gray-100); }

  .mega-title {
    display: block;
    font-size: 13px;
    color: var(--text);
    margin-bottom: 6px;
    transition: color 0.15s;
  }
  .mega-item:hover .mega-title { color: var(--teal); }

  .mega-desc {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    ul { gap: 20px; flex-wrap: wrap; }

    .mega-menu { position: static; padding-top: 10px; }
    .mega-panel {
      width: auto;
      grid-template-columns: 1fr;
      gap: 16px;
      box-shadow: none;
      border: none;
      padding: 10px 0 0 16px;
    }
  }
</style>
